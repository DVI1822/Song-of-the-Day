# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API Keys). These two are safe to be public:
# they end up in the browser anyway, and the database's own rules decide
# what anyone can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: a song.link API key, for more than ~10 song lookups a minute.
# ODESLI_API_KEY=
